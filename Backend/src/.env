# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/mindvault

# ── Python AI Microservice ────────────────────────────────────────────────────
# Base URL of the external Python service (no trailing slash)
PYTHON_SERVICE_URL=http://localhost:8000

# ── Mock Mode ─────────────────────────────────────────────────────────────────
# Set to "true" to run fully without the Python service (for demos / CI)
MOCK_MODE=false
# MindVault Backend Environment Configuration

# Server Port
PORT=5000

# MongoDB Connection URL
MONGO_URI=mongodb://localhost:27017/mindvault
# If using MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mindvault?retryWrites=true&w=majority

# Python AI Microservice URL (running api.py via uvicorn)
PYTHON_SERVICE_URL=http://localhost:8000

# Mock Mode (set to "true" to use built-in fixtures without external network calls)
MOCK_MODE=false

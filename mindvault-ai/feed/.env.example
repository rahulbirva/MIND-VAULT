# Copy this file to .env and fill in real values, or just export these
# as environment variables before running python3 pipeline.py

# --- MongoDB ---
# Local MongoDB (if you installed it yourself, e.g. via `brew install mongodb-community`
# or the MongoDB installer): leave this as-is.
MONGO_URI=mongodb://localhost:27017

# OR, if you're using MongoDB Atlas (cloud, free tier) — recommended if you don't
# want to install/run Mongo locally during a hackathon — paste your connection
# string here instead (from Atlas dashboard > Connect > Drivers):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

DB_NAME=mindvault

# --- AI model ---
MODEL_NAME=qwen2.5:7b

# --- Testing ---
# Set to "true" to skip live search/scraping/AI calls and use instant mock data
# (useful for fast frontend testing without waiting on real network/AI calls)
MOCK_MODE=false
